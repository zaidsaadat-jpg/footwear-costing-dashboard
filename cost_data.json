  "processFlow": {
    "notes": "The end-to-end shoe manufacturing journey. Cost shares are typical percentages of FOB for a running shoe.",
    "stages": [
      {
        "id": "raw-materials",
        "order": 1,
        "name": "Raw Materials",
        "icon": "🌾",
        "costSharePct": 31.0,
        "location": "Regional suppliers — China · Vietnam · Indonesia",
        "leadTimeDays": "30–45 days",
        "drivers": ["Natural rubber price (oil-linked)", "EVA resin price (ethylene-linked)", "Polyester yarn price (PTA-linked)", "rPET pellet price", "Supplier lead time", "Material quality grade"],
        "process": "Raw rubber sheets, EVA resin pellets, polyester yarn, TPU film, and textile lining are sourced from Tier-2 chemical and textile suppliers. Materials are consolidated and shipped to component factories where they enter the manufacturing process.",
        "inputs": ["Oil & natural rubber", "Ethylene derivatives", "PET polymer", "Cotton", "Processing chemicals"],
        "outputs": ["Rubber sheet rolls", "EVA pellets", "Polyester yarn", "TPU film", "Lining rolls"]
      },
      {
        "id": "component-mfg",
        "order": 2,
        "name": "Component Manufacturing",
        "icon": "⚙️",
        "costSharePct": 28.0,
        "location": "Component factories — Vietnam · Indonesia",
        "leadTimeDays": "20–30 days",
        "drivers": ["Mould tooling amortisation", "Compression moulding cycle time", "Machine energy cost", "Skilled operator minutes", "Quality yield rate"],
        "process": "Rubber is compounded with additives, calendered into sheets, and compression-moulded into outsoles. EVA pellets are supercritically infused with nitrogen and moulded into midsole foam. Polyester yarn is circular-knitted into the upper mesh. TPU film is heat-pressed onto reinforcement zones.",
        "inputs": ["Rubber sheet", "EVA pellets", "Polyester yarn", "TPU film"],
        "outputs": ["Moulded outsole", "Supercritical foam midsole", "Knitted upper panels", "Reinforcement panels"]
      },
      {
        "id": "cutting",
        "order": 3,
        "name": "Cutting",
        "icon": "✂️",
        "costSharePct": 6.0,
        "location": "Main assembly factory — Vietnam",
        "leadTimeDays": "5–7 days",
        "drivers": ["Cutting labour minutes", "CNC machine cycle time", "Material utilisation rate", "Cutting die amortisation"],
        "process": "Rolls of mesh, lining, and reinforcement are spread on cutting tables. CNC cutting machines process multiple layers at once, following a digital marker to maximise material yield. Roughly 6.7 minutes of labour and machine time per pair.",
        "inputs": ["Knitted upper roll", "Lining roll", "Reinforcement panels"],
        "outputs": ["Cut upper panels", "Cut lining panels", "Cut reinforcement strips"]
      },
      {
        "id": "stitching",
        "order": 4,
        "name": "Stitching",
        "icon": "🧵",
        "costSharePct": 6.0,
        "location": "Main assembly factory — Vietnam",
        "leadTimeDays": "7–10 days",
        "drivers": ["Stitching labour minutes", "Sewing machine time", "Thread consumption", "Design complexity (panel count)"],
        "process": "Cut panels are stitched together — main seams first, then collar and lining. Eyelets and hardware are inserted. Roughly 40–60 individual stitches per shoe. Higher panel counts increase both labour and machine time proportionally.",
        "inputs": ["Cut upper panels", "Cut lining panels", "Sewing thread", "Eyelets", "Branding transfers"],
        "outputs": ["Stitched upper (shoe shape)"]
      },
      {
        "id": "assembly",
        "order": 5,
        "name": "Assembly & Bonding",
        "icon": "🔧",
        "costSharePct": 11.0,
        "location": "Main assembly factory — Vietnam",
        "leadTimeDays": "5–7 days",
        "drivers": ["Assembly labour minutes", "Compression press cycle time", "Adhesive consumption", "Last tooling amortisation"],
        "process": "The stitched upper is placed on a shoe last and heated to set its final shape. Adhesive is applied to the midsole edge. Upper and midsole are pressed together in a compression press. The outsole is then bonded in a second pressing stage.",
        "inputs": ["Stitched upper", "Foam midsole", "Moulded outsole", "PU adhesive"],
        "outputs": ["Bonded shoe (unfinished)"]
      },
      {
        "id": "finishing",
        "order": 6,
        "name": "Finishing & Quality Control",
        "icon": "🔍",
